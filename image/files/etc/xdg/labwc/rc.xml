<?xml version="1.0"?>
<labwc_config>
  <theme>
    <name>Auriliux</name>
    <cornerRadius>6</cornerRadius>
    <font place="ActiveWindow"><name>Noto Sans</name><size>10</size><weight>Bold</weight></font>
  </theme>
  <core><gap>0</gap></core>
  <keyboard>
    <default />
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-b"><action name="Execute" command="google-chrome-stable" /></keybind>
    <!-- Bildschirm sperren: Super+L oder wie am Mac Ctrl+Cmd+Q -->
    <keybind key="W-l"><action name="Execute" command="/usr/libexec/auriliux/sperren" /></keybind>
    <keybind key="C-W-q"><action name="Execute" command="/usr/libexec/auriliux/sperren" /></keybind>
  </keyboard>
</labwc_config>
