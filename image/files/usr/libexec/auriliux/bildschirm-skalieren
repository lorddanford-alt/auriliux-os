#!/bin/sh
# Bildschirm-Größe beim Start: zuerst, was in der Zentrale eingestellt wurde (~/.config/auriliux/skalierung,
# Zeilen „Name Faktor“). Sonst: Retina-Bildschirm des MacBooks (eingebaut, mindestens 2400 Pixel breit) → doppelt
# so groß, sonst wäre die Oberfläche winzig. Externe Bildschirme bleiben, wie sie sind.
wahl="${HOME:-/nonexistent}/.config/auriliux/skalierung"
wlr-randr 2>/dev/null | awk '/^[^ ]/ { name = $1 } /current/ { print name, $1 }' | while read -r name modus; do
    faktor=""
    [ -r "$wahl" ] && faktor=$(awk -v n="$name" '$1 == n && $2 ~ /^[0-9]+(\.[0-9]+)?$/ { print $2 }' "$wahl" | tail -1)
    if [ -n "$faktor" ]; then
        wlr-randr --output "$name" --scale "$faktor"
        continue
    fi
    breite=${modus%%x*}
    case "$name" in
        eDP*|LVDS*) [ "${breite:-0}" -ge 2400 ] 2>/dev/null && wlr-randr --output "$name" --scale 2 ;;
    esac
done
exit 0
