[Unit]
Description=Auriliux: Firmware der FaceTime-Kamera einrichten (einmalig, lokal)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/firmware/facetimehd/firmware.bin
# höchstens 10 Versuche pro Stunde (ohne Netz nicht endlos)
StartLimitIntervalSec=3600
StartLimitBurst=10

[Service]
Type=oneshot
ExecStart=/usr/libexec/auriliux/kamera-firmware
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
