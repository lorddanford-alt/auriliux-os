# Auriliux OS – Rezept für das Systemabbild (Bau aus dem Hauptordner: podman build -f image/Containerfile .)

# ── Stufe 1: eigene Programme kompilieren (Goldleiste usw. + Dienste Guardian/Herzschlag) ──
FROM quay.io/fedora/fedora:45 AS bau
RUN dnf -y install --setopt=install_weak_deps=False \
        cmake ninja-build gcc-c++ qt6-qtbase-devel qt6-qtbase-private-devel qt6-qtdeclarative-devel \
        layer-shell-qt-devel qt6-qtwayland-devel qt6-qtmultimedia-devel wayland-devel wayland-protocols-devel pam-devel pkgconf-pkg-config \
        rust cargo \
    && dnf clean all
# Dienste in Rust (nur Standardbibliothek – nichts wird aus dem Netz nachgeladen)
COPY dienste /quelle/dienste
RUN cd /quelle/dienste \
    && cargo test --release --offline \
    && cargo build --release --offline \
    && install -Dm755 target/release/auriliux-guardian /ausgabe/usr/libexec/auriliux/auriliux-guardian \
    && install -Dm755 target/release/auriliux-herzschlag /ausgabe/usr/libexec/auriliux/auriliux-herzschlag \
    && install -Dm755 target/release/auriliux-tresor /ausgabe/usr/libexec/auriliux/auriliux-tresor
COPY shell /quelle/shell
RUN cmake -S /quelle/shell -B /bauordner -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    && cmake --build /bauordner \
    && DESTDIR=/ausgabe cmake --install /bauordner

# ── Stufe 1b: Boot-Intro (Plymouth-Thema) aus der Aufnahme des Laser-Intros bauen ──
# Die Aufnahme macht der Cloud-Bau vorher mit Chrome (werkzeuge/intro-aufnehmen.mjs); fehlt sie,
# entsteht ein ruhiges Thema mit dem fertigen Logo.
FROM quay.io/fedora/fedora:45 AS intro
RUN dnf -y install --setopt=install_weak_deps=False python3-pillow google-noto-sans-mono-fonts && dnf clean all
COPY werkzeuge/intro-thema.py /intro/intro-thema.py
COPY image/intro-roh /intro/roh
COPY image/files/usr/share/auriliux/logo.png /intro/logo.png
RUN python3 /intro/intro-thema.py /intro/roh /intro/logo.png /ausgabe/usr/share/plymouth/themes/auriliux

# ── Stufe 2: das eigentliche System ───────────────────────────────────────────
# Basis: Fedora 45 bootc (unveränderliches System, Updates als ganzes Abbild, Rückweg zum vorherigen Stand)
FROM quay.io/fedora/fedora-bootc:45

LABEL org.opencontainers.image.title="Auriliux OS" \
      org.opencontainers.image.description="Schlankes, sicheres System für das MacBook Pro 12,1 im Auriliux-Gold-Stil"

# ── Paketquellen: Google Chrome, Kameratreiber (FaceTime HD) ─────────────────
COPY image/repos/*.repo /etc/yum.repos.d/

# ── Grundsystem ──────────────────────────────────────────────────────────────
# Oberfläche: labwc (Fenster-Manager, Wayland) + Qt 6/QML für alle eigenen Programme
# Ton: PipeWire · Netz: NetworkManager (WLAN-Treiber brcmfmac für BCM43602)
# Schutz: firewalld, ClamAV, YARA, USBGuard · Tresor: btrfs-Schnappschüsse + restic (verschlüsselte Sicherung)
# Leistung: zram (komprimierter Arbeitsspeicher)
RUN dnf -y install --setopt=install_weak_deps=False \
        labwc swaybg wlr-randr grim slurp foot wl-clipboard xdg-desktop-portal-wlr \
        xorg-x11-server-Xwayland \
        qt6-qtbase qt6-qtbase-gui qt6-qtdeclarative qt6-qtsvg qt6-qtwayland qt6-qtmultimedia \
        layer-shell-qt \
        mesa-dri-drivers mesa-vulkan-drivers libva-intel-media-driver libva-utils \
        pipewire wireplumber pipewire-pulseaudio pipewire-alsa \
        NetworkManager-wifi NetworkManager-tui brcmfmac-firmware wpa_supplicant bluez udisks2 \
        greetd tuigreet plymouth plymouth-plugin-script \
        firewalld clamav clamd clamav-freshclam yara usbguard \
        btrfs-progs restic zram-generator \
        lm_sensors brightnessctl \
        google-chrome-stable \
        google-noto-sans-fonts google-noto-sans-mono-fonts google-noto-color-emoji-fonts adwaita-icon-theme \
        git curl unzip cpio xdg-utils xdg-user-dirs glibc-langpack-de \
    && dnf clean all

# ── Chrome: Paket schreibt nach /opt, das ist auf dem unveränderlichen System gesperrt ──
# → nach /usr/lib verschieben, /opt/google zeigt beim Start dorthin
RUN if [ -d /opt/google ]; then mv /opt/google /usr/lib/google; fi \
    && ln -sf /usr/lib/google/chrome/google-chrome /usr/bin/google-chrome-stable \
    && printf 'L+ /var/opt/google - - - - /usr/lib/google\n' > /usr/lib/tmpfiles.d/auriliux-chrome.conf

# ── FaceTime-Kamera: Treiber für den Kern des Abbilds bauen ────────────────────
# Die Kamera-Firmware selbst wird NICHT ins Abbild gelegt (Apple-Lizenz), sondern beim ersten
# Start auf deinem Mac geladen/ausgelesen und unter /var/lib/firmware abgelegt.
RUN KVER="$(ls /usr/lib/modules | head -1)" \
    && dnf -y install --setopt=install_weak_deps=False akmods "kernel-devel-${KVER}" akmod-facetimehd \
    && akmods --force --kernels "${KVER}" \
    && dnf -y remove "kernel-devel-${KVER}" akmod-facetimehd akmods \
    && { rpm -e --nodeps facetimehd-firmware 2>/dev/null || true; } \
    && rm -rf /usr/lib/firmware/facetimehd /var/log/akmods /var/cache/akmods \
    && test ! -e /usr/lib/firmware/facetimehd \
    && ls /usr/lib/modules/"${KVER}"/extra/facetimehd/ \
    && dnf clean all

# ── Auriliux-Dateien (Design, Dienste, Einstellungen) ─────────────────────────
COPY image/files/ /
COPY --from=bau /ausgabe/ /
COPY --from=intro /ausgabe/ /

# ── Boot-Intro ins initramfs (dort läuft Plymouth und fragt ggf. nach dem Festplatten-Passwort) ──
# Danach Gegenprobe: alle bisherigen dracut-Teile sind noch da, und das Thema ist drin.
RUN kver="$(ls /usr/lib/modules | head -1)" && img="/usr/lib/modules/$kver/initramfs.img" \
    && ls -la "$img" \
    && lsinitrd --mod "$img" | grep -E '^[A-Za-z0-9_-]+$' | sort > /tmp/vorher \
    && dracut --force --no-hostonly --reproducible --kver "$kver" "$img" \
    && lsinitrd --mod "$img" | grep -E '^[A-Za-z0-9_-]+$' | sort > /tmp/nachher \
    && echo "dracut-Teile vorher $(wc -l < /tmp/vorher), nachher $(wc -l < /tmp/nachher): $(comm -13 /tmp/vorher /tmp/nachher | tr '\n' ' ')" \
    && if comm -23 /tmp/vorher /tmp/nachher | grep -q .; then echo "FEHLER: dracut-Teile fehlen:"; comm -23 /tmp/vorher /tmp/nachher; exit 1; fi \
    && lsinitrd "$img" | grep -q "plymouth/themes/auriliux/auriliux.script" \
    && grep -q "plymouth" /tmp/nachher \
    && chmod 0644 "$img" && ls -la "$img" && rm -f /tmp/vorher /tmp/nachher \
    && groesse=$(stat -c %s "$img") && if [ "$groesse" -gt 200000000 ]; then echo "FEHLER: initramfs zu groß ($groesse Bytes)"; exit 1; fi

# ── Schrift Cinzel (Titel wie auf der Auriliux-Webseite, SIL Open Font License), fest auf eine Version gepinnt ──
RUN mkdir -p /usr/share/fonts/auriliux \
    && curl -fsSL -o /usr/share/fonts/auriliux/Cinzel.ttf \
       "https://raw.githubusercontent.com/google/fonts/3dd78844021e948ceb633d1dcee3f7885561b5d9/ofl/cinzel/Cinzel%5Bwght%5D.ttf" \
    && curl -fsSL -o /usr/share/fonts/auriliux/OFL-Cinzel.txt \
       "https://raw.githubusercontent.com/google/fonts/3dd78844021e948ceb633d1dcee3f7885561b5d9/ofl/cinzel/OFL.txt" \
    && fc-cache -f /usr/share/fonts/auriliux

# Stand dieses Abbilds (zeigt die Zentrale unter „Updates“ und „Über“)
RUN date -u +%Y-%m-%dT%H:%M:%SZ > /usr/share/auriliux/stand

# Hilfseinträge des Terminals nicht in der App-Suche zeigen
RUN for d in footclient foot-server; do f=/usr/share/applications/$d.desktop; \
        [ -f "$f" ] && sed -i 's/^\[Desktop Entry\]$/[Desktop Entry]\nNoDisplay=true/' "$f"; done; true

# ── Name und Einstellungen ──────────────────────────────────────────────────────
RUN sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Auriliux OS (Fedora 45)"/' /usr/lib/os-release \
    && systemctl enable firewalld clamav-freshclam greetd auriliux-kamera-firmware.service \
       auriliux-guardian.service auriliux-herzschlag.service auriliux-update.timer \
       auriliux-update-stand.service bluetooth.service auriliux-tresor.service auriliux-tresor-vorbereiten.service \
    && { systemctl mask bootc-fetch-apply-updates.timer 2>/dev/null || true; } \
    && firewall-offline-cmd --set-default-zone=drop \
    && systemctl set-default graphical.target

# USBGuard wird bewusst NICHT hier eingeschaltet: ohne Regeln würde es auch die eingebaute Tastatur und das
# Trackpad (beim MacBook intern per USB angeschlossen) sperren. Guardian erzeugt beim ersten Start eine Regel
# für alle eingebauten Geräte und schaltet es erst dann ein.
# Updates: Fedoras eigener Update-Takt würde nach dem Laden sofort NEU STARTEN (offene Arbeit weg) – er ist
# deshalb abgeschaltet. auriliux-update.timer lädt täglich und aktiviert erst beim nächsten Neustart.

# Aufräumen (Protokolle und Reste des Baus gehören nicht ins Abbild)
RUN rm -rf /var/log/dnf5.log* /var/log/akmods /tmp/* /run/* 2>/dev/null; \
    sed -i '/^akmods:/d' /etc/passwd /etc/shadow /etc/group /etc/gshadow 2>/dev/null; true

# Prüfung des fertigen Abbilds (schlägt beim Bau fehl, wenn etwas Grundlegendes fehlt)
RUN bootc container lint
